SHAMARAN_PROVIDER=ollama
SHAMARAN_WORKSPACE=./workspace
SHAMARAN_MAX_STEPS=8
SHAMARAN_LOG_LEVEL=INFO
SHAMARAN_CONFIRM_MUTATIONS=true
SHAMARAN_MEMORY_DB=./data/shamaran_memory.db

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=YOUR_MODEL_NAME
OLLAMA_TIMEOUT=60

# Optional: LM Studio, LocalAI, vLLM, llama.cpp, or another OpenAI-compatible server.
SHAMARAN_COMPATIBLE_BASE_URL=http://localhost:1234/v1
SHAMARAN_COMPATIBLE_MODEL=
# Keep secrets in the environment or this ignored local file; never commit them.
SHAMARAN_COMPATIBLE_API_KEY=
SHAMARAN_COMPATIBLE_TIMEOUT=60
